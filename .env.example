# Do'kon Boshqaruv — Server muhiti sozlamalari (Environment Configuration)

# Ishlash rejimi (production tavsiya etiladi)
NODE_ENV=production

# Server porti va xost
PORT=3000
HOST=0.0.0.0

# Vaqt mintaqasi (O'zbekiston uchun Asia/Tashkent)
TZ=Asia/Tashkent

# Nginx, Caddy yoki Cloudflare kabi teskari proksi (reverse proxy) orqasida ishlasa:
# 1 — agar Nginx/Caddy orqali SSL/HTTPS qo'yilgan bo'lsa
TRUST_PROXY=1

# Ma'lumotlar saqlanadigan asosiy papka (sukut bo'yicha: ./data)
# DATA_DIR=/var/lib/dokon/data

# Avtomatik zaxira nusxalar sozlamasi
# BACKUP_DIR=/var/backups/dokon
# BACKUP_HOUR=03
# BACKUP_KEEP=14
# Tashqi disk yoki ikkinchi saqlash joyi (ixtiyoriy)
# BACKUP_COPY_DIR=/mnt/external_backup
